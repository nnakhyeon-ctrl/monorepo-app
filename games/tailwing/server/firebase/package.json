{
  "name": "tailwing-auth-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "build/src/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test build/test/unit.test.js build/test/social-proof.test.js build/test/deletion-portal.test.js build/test/billing-unit.test.js build/test/api-logging.test.js",
    "test:emulator": "node tool/run-emulators.mjs",
    "test:native-email": "node tool/run-emulators.mjs --native-email",
    "test:native-core": "node tool/run-emulators.mjs --native-core",
    "test:native-persistence": "node tool/run-emulators.mjs --native-persistence",
    "dev:emulator": "node tool/run-emulators.mjs --serve"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "11.3.1",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "firebase-tools": "15.34.0",
    "typescript": "7.0.2"
  }
}
